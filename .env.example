# Copy to .env for local development. Nothing here is needed to run in demo mode.

# Port for the local server (default 3000)
PORT=3000

# The family password that unlocks editing. Locally it defaults to "run".
# On Cloud Run it comes from Secret Manager (see README).
EDIT_PASSWORD=

# Signs the edit cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
