# Copy to .env for local development. Nothing here is needed to run locally.

# Port for the local server (default 3000)
PORT=3000

# The family's 4-digit code. Locally it defaults to 1234.
# On Cloud Run it comes from Secret Manager (see README).
FAMILY_PIN=

# Signs the member cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Kicker shown at the top of every screen
FAMILY_NAME=FAMILIENS LØBEKLUB
